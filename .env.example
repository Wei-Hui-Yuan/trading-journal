# Copy to .env.local (Next.js loads this automatically) and fill in real
# values. Never commit .env.local.
#
# See api/.env.example for the backend's own env file -- it is separate and
# lives in api/.env, not here.

# ---------------------------------------------------------------------------
# Clerk (authentication)
# ---------------------------------------------------------------------------
# Clerk Dashboard -> API Keys. The publishable key is exposed to the browser
# by design (NEXT_PUBLIC_*); the secret key is server-only and must never be
# prefixed with NEXT_PUBLIC_.
#
# Both are optional for a quick local spin-up: if NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# is unset, `next dev` auto-provisions a throwaway "keyless" Clerk instance so
# the app boots without an account. Real, persistent auth needs your own
# Clerk app and both keys below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Where the FastAPI backend (api/) is reachable. Optional for local dev --
# defaults to http://localhost:8000, which is where `uvicorn main:app --reload`
# listens by default (see api/README.md).
#
# NEXT_PUBLIC_* vars are baked into the build at BUILD time, not read at
# runtime -- changing this after building requires a rebuild, not just a
# restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
