# Copy to .env and fill in real values. Never commit .env.
#
# ---------------------------------------------------------------------------
# Supabase Postgres
# ---------------------------------------------------------------------------
# Option A: full connection string.
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the transaction pooler (port 6543); the app auto-upgrades the
# postgresql:// scheme to postgresql+asyncpg://.
# Note: paste your password WITHOUT the surrounding [ ] that Supabase shows.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-your-region.pooler.supabase.com:6543/postgres

# Option B: individual parts (used only if DATABASE_URL is unset)
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres

# ---------------------------------------------------------------------------
# IBKR Flex Web Service (used by POST /api/sync/ibkr)
# ---------------------------------------------------------------------------
# Account Management -> Reports -> Flex Queries -> Flex Web Service
# Set the query period to cover the range you want to backfill; a query scoped
# to "Today" returns no fills outside of trading hours.
IBKR_TOKEN=your-flex-web-service-token
IBKR_QUERY_ID=your-flex-query-id

# ---------------------------------------------------------------------------
# Clerk JWT verification (api/auth.py)
# ---------------------------------------------------------------------------
# Public key set used to check the signature on incoming session tokens.
# Clerk Dashboard -> API Keys -> Show API URLs -> Frontend API URL, then
# append /.well-known/jwks.json
#
# Required in the Northflank environment: without it every protected route
# returns 500 rather than silently accepting unverified requests.
# This URL is public -- it holds no secret.
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Optional. The expected `iss` claim, derived from CLERK_JWKS_URL when unset.
# Only needed if your Clerk instance issues tokens under a custom domain that
# differs from the JWKS host.
# CLERK_ISSUER=https://clerk.your-domain.com

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# http://localhost:3000 is always allowed. Add production origins here as a
# comma-separated list.
CORS_ALLOW_ORIGINS=https://your-app.vercel.app

# Optional regex, for hosts that change on every deploy. Vercel issues a new
# URL per deployment, so an exact origin goes stale as soon as you redeploy.
# Anchor it to your project name -- do NOT use a bare https://.*\.vercel\.app,
# which would let any Vercel-hosted site call this API.
# CORS_ALLOW_ORIGIN_REGEX=https://trading-journal-.*\.vercel\.app
